# TEMPLATE ONLY. Never commit credentials, database hostnames, user IDs or keys.
# For local testing, set NODE_ENV=test and ACADEMY_ACCESS_STATE=restricted
# with a disposable local PostgreSQL database. Production must use HTTPS.
NODE_ENV=production
ACADEMY_ORIGIN=https://records.example.invalid
DATABASE_URL=postgresql://USER:REDACTED@DATABASE_HOST/academy?sslmode=verify-full

# Closed is the production default and blocks login and portal access.
# Only switch to restricted after independent gateway, MFA and network
# access controls are installed/tested. This switch DOES NOT provide MFA.
ACADEMY_ACCESS_STATE=closed

# Local reverse proxy: use 127.0.0.1. Render proxy: use 0.0.0.0 and PORT.
HOST=127.0.0.1
PORT=8787

# 32 random bytes as canonical base64, stored ONLY in the host secret manager.
# ACADEMY_SIGNATURE_ENCRYPTION_KEY=<do not commit>
# Dedicated, DIFFERENT 32-byte canonical base64 key for encrypted staff TOTP.
# ACADEMY_TOTP_ENCRYPTION_KEY=<do not commit>
# Production source masters: install in a private mounted volume.
# ACADEMY_CERTIFICATE_MASTER_DIR=/private/academy/certificate-masters

# Bootstrap is a separate ONE-TIME operator action, never enabled for a
# production HTTP server. Remove settings immediately after bootstrapping.
# ACADEMY_ENABLE_BOOTSTRAP=true
# ACADEMY_BOOTSTRAP_EMAIL=...
# ACADEMY_BOOTSTRAP_PASSWORD=...
