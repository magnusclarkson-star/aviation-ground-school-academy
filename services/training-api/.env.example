# PRIVATE staging-only API — never commit actual credentials.
NODE_ENV=development
PORT=3100
HOST=127.0.0.1
AGSA_PUBLIC_ORIGIN=http://127.0.0.1:3100
AGSA_ALLOW_INSECURE_LOCAL=1
DATABASE_URL=postgresql://agsa_user:change-me@127.0.0.1:5432/agsa_training_staging
# In deployed staging: HTTPS public origin, isolated TLS-terminating proxy and no insecure-local flag.
# PGSSL_MODE=verify-full
# AGSA_PROVISION_PASSWORD=Use_a_long_password_from_a_secret_manager
