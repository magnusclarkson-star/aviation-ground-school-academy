# PRIVATE staging-only API — never commit actual credentials.
NODE_ENV=development
PORT=3100
HOST=127.0.0.1
AGSA_PUBLIC_ORIGIN=http://127.0.0.1:3100
AGSA_ALLOW_INSECURE_LOCAL=1
DATABASE_URL=postgresql://agsa_user:change-me@127.0.0.1:5432/agsa_training_staging
# In deployed staging: HTTPS public origin, isolated TLS-terminating proxy and no insecure-local flag.
# PGSSL_MODE=verify-full
# AGSA_PROVISION_PASSWORD=Use_a_long_password_from_a_secret_manager

# Mandatory for all staging server boots; use one persistent 32-byte key per staging environment.
# Generate LOCALLY using: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Store in a secret manager. Never copy into Git, chat messages, screenshots or CI logs.
# AGSA_MFA_ENCRYPTION_KEY=<generated 43-character base64url value>


# OPTIONAL operator-only invite sender. Do not set these to fake production values.
# Invitation delivery is disabled unless provider, key, verified sender and HTTPS
# origin are configured. The API itself never exposes an invite issuance route.
# AGSA_MAIL_PROVIDER=resend
# AGSA_RESEND_API_KEY=<stored-outside-Git>
# AGSA_MAIL_FROM=noreply@verified-staging-domain.example
# AGSA_PUBLIC_ORIGIN=https://private-staging-domain.example


# OPTIONAL AI INSTRUCTOR: Disabled by default. Set both flags to 1 only after
# private staging deployment, student consent, provider account and spend limits.
# AGSA_AI_ENABLED=0
# AGSA_AI_VOICE_ENABLED=0
# AGSA_AI_TEXT_MODEL=gpt-6-luna
# OPENAI_API_KEY=<secret-manager-entry-never-commit>
# AI voice currently uses transitional deprecated Speech API, due 2027-01-06.


# TWO-WAY AI VOICE, private staging only. All three flags must be 1,
# with a secure server-side OPENAI_API_KEY. The public site never sees it.
# AGSA_AI_REALTIME_ENABLED=0
# AGSA_AI_REALTIME_STAGING_APPROVED=0
# Real calls are billed by the provider. Configure project budget alerts/limits.
# Server voice model is fixed to gpt-realtime-2.1-mini.
