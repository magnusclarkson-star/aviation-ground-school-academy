{
  "name": "agsa-training-api",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "migrate": "node scripts/migrate.mjs",
    "provision": "node scripts/provision.mjs",
    "test": "node --test tests/validation.test.mjs tests/http.test.mjs tests/mfa.test.mjs tests/invites.test.mjs tests/grants.test.mjs tests/ai.test.mjs tests/realtime.test.mjs tests/module-learning.test.mjs",
    "test:integration": "node --test tests/postgres.integration.test.mjs tests/realtime-durable.integration.test.mjs tests/module-learning.integration.test.mjs tests/grants.test.mjs",
    "test:all": "node --test tests/*.test.mjs",
    "invite": "node scripts/send-invite.mjs"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
